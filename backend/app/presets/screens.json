[
 {
  "name": "Breakout on volume",
  "description": "Price just broke above its 3-month high on at least twice the usual volume, in a long-term uptrend.",
  "rule": {
   "all": [
    {
     "left": {
      "ind": "close",
      "params": {}
     },
     "op": "crosses_above",
     "right": {
      "ind": "highest",
      "params": {
       "n": 63
      }
     }
    },
    {
     "left": {
      "ind": "volume_ratio",
      "params": {
       "n": 20
      }
     },
     "op": ">=",
     "right": {
      "value": 2
     }
    },
    {
     "left": {
      "ind": "close",
      "params": {}
     },
     "op": ">",
     "right": {
      "ind": "sma",
      "params": {
       "n": 200
      }
     }
    }
   ]
  }
 },
