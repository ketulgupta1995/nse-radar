 {
  "name": "52-week high breakout",
  "description": "Price just closed above its highest level of the past year, on above-normal volume, while the market is in an uptrend.",
  "rule": {"all": [
   {"left": {"ind": "close", "params": {}}, "op": "crosses_above", "right": {"ind": "highest", "params": {"n": 252}}},
   {"left": {"ind": "volume_ratio", "params": {"n": 20}}, "op": ">=", "right": {"value": 1.5}},
   {"left": {"ind": "index_vs_sma", "params": {"n": 200}}, "op": ">", "right": {"value": 0}}
  ]}
 },
 {
  "name": "Promoters buying, in uptrend",
  "description": "The founders or parent company raised their stake over the past year, and the price is trending up.",
  "rule": {"all": [
   {"left": {"fund": "promoter_change_1y_pp"}, "op": ">", "right": {"value": 0}},
   {"left": {"ind": "close", "params": {}}, "op": ">", "right": {"ind": "sma", "params": {"n": 200}}},
   {"left": {"ind": "rel_strength", "params": {"n": 126}}, "op": ">", "right": {"value": 0}}
  ]}
 },
 {
  "name": "Breadth trend riders",
  "description": "Uptrend leaders, but only while most stocks are in uptrends too. Breadth caught the 2018 small-cap fall that the index filter missed.",
  "rule": {"all": [
   {"left": {"ind": "close", "params": {}}, "op": ">", "right": {"ind": "sma", "params": {"n": 50}}},
   {"left": {"ind": "sma", "params": {"n": 50}}, "op": ">", "right": {"ind": "sma", "params": {"n": 200}}},
   {"left": {"ind": "rel_strength", "params": {"n": 126}}, "op": ">", "right": {"value": 10}},
   {"left": {"ind": "pct_from_high", "params": {"n": 252}}, "op": ">", "right": {"value": -15}},
   {"left": {"ind": "breadth_above_sma", "params": {"n": 200}}, "op": ">", "right": {"value": 50}}
  ]}
 },
 {
  "name": "Results winners",
  "description": "Stocks that jumped at least 5% on their latest quarterly results in the last two months. Strong reactions often keep drifting up.",
  "rule": {"all": [
   {"left": {"ind": "results_move", "params": {"k": 2}}, "op": ">=", "right": {"value": 5}},
   {"left": {"ind": "days_since_results", "params": {}}, "op": "<=", "right": {"value": 40}},
   {"left": {"ind": "close", "params": {}}, "op": ">", "right": {"ind": "sma", "params": {"n": 200}}},
   {"left": {"ind": "traded_value_cr", "params": {"n": 20}}, "op": ">=", "right": {"value": 5}}
  ]}
 },
 {
  "name": "Leaders in leading industries",
  "description": "Stocks beating their own industry, in an industry that is beating the market.",
  "rule": {"all": [
   {"left": {"ind": "industry_strength", "params": {"n": 63}}, "op": ">", "right": {"value": 0}},
   {"left": {"ind": "industry_rs", "params": {"n": 63}}, "op": ">", "right": {"value": 0}},
   {"left": {"ind": "rel_strength", "params": {"n": 126}, "rank": true}, "op": ">=", "right": {"value": 80}},
   {"left": {"ind": "close", "params": {}}, "op": ">", "right": {"ind": "sma", "params": {"n": 50}}}
  ]}
 },
 {
  "name": "Short dip in uptrend",
  "description": "A stock in a long uptrend that fell sharply for a couple of days. Meant for short holds of about a week: pair it with the Short dip exits.",
  "rule": {"all": [
   {"left": {"ind": "rsi", "params": {"n": 2}}, "op": "<", "right": {"value": 10}},
   {"left": {"ind": "close", "params": {}}, "op": ">", "right": {"ind": "sma", "params": {"n": 200}}},
   {"left": {"ind": "traded_value_cr", "params": {"n": 20}}, "op": ">=", "right": {"value": 5}}
  ]}
 }
