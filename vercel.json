{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build",
      "outputDirectory": "dist",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top)frontend' ':(top)vercel.json' ':(top,exclude)**/*.md' ':(top,exclude)frontend/src/__tests__'",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top)api' ':(top)backend/app' ':(top)requirements.txt' ':(top)vercel.json' ':(top,exclude)**/*.md'",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "excludeFiles": "{backend/tests/**,frontend/**,docs/**,tickets/**,scripts/**,data/**,logs/**}"
        }
      }
    }
  },
  "crons": [
    { "path": "/api/cloud/tick", "schedule": "0 3 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 5 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 7 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 10 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 14 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 15 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 16 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 17 * * *" },
    { "path": "/api/cloud/tick", "schedule": "0 21 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
