# nse-radar environment variables (SPEC §17.2, §17.5). Copy to .env.local for dev; never commit real values.
# Leave everything empty for local dev on a plain SQLite file (data/stock.db).

# Runtime mode: local (dev, tests) | vercel (web app) | actions (cloud worker drain)
STOCK_RUNTIME=

# Turso database URL, e.g. libsql://<db>-<org>.turso.io. Empty -> local SQLite file.
TURSO_DATABASE_URL=

# Turso auth token for that database (secret).
TURSO_AUTH_TOKEN=

# Actions only: path of the embedded replica file (e.g. data/replica.db). Empty -> remote Turso.
STOCK_REPLICA_PATH=

# GitHub repo "owner/nse-radar", used by Vercel to dispatch the drain workflow.
GITHUB_REPO=

# Fine-grained GitHub token (this repo only, Actions read/write) for workflow dispatch (secret).
GITHUB_DISPATCH_TOKEN=

# Password for the web app. Unset -> the password gate is off (local dev).
APP_PASSWORD=

# Random secret used to sign the login cookie (secret).
APP_SECRET=

# Actions only: passphrase that encrypts the weekly backup artifact (secret).
BACKUP_PASSPHRASE=
